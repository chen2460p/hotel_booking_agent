# 复制本文件为同目录下的 .env，并填入你自己的密钥；.env 不会被提交到 Git
# cp .env.example .env

# 通义千问 DashScope（必填，真实 LLM 模式；留空则使用内置规则引擎模拟模式）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 高德开放平台 Web 服务 Key（选填，用于道旅不可用时的 POI 回退搜索）
# 申请地址：https://lbs.amap.com/
AMAP_API_KEY=

# 道旅 RollingGo 开发者 Key（必填，真实酒店搜索/房价；mcp_ 开头）
ROLLINGGO_API_KEY=

# ===== 以下均为可选项，一般无需修改 =====
# 道旅 MCP / REST 网关地址
#ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
# OAuth 中转与授权地址（python rollinggo_book.py login 使用）
#ROLLINGGO_OAUTH_SERVER=https://rollinggo.store
#ROLLINGGO_OAUTH_AUTHORIZE=https://api.rollinggo.cn/oauth2/authorize
# OAuth Client ID（国内版固定）
#ROLLINGGO_CLIENT_ID=rollinggoskill
