# 复制本文件为同目录下的 .env，并填入你自己的密钥；.env 不会被提交到 Git
# cp .env.example .env

# 通义千问 DashScope（必填，真实 LLM 模式；留空则使用内置规则引擎模拟模式）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 意图识别模型（可选）：默认 deepseek-v4.1-flash（120 条评测全对、比 qwen3.8-flash 快约 2.5 倍）
# 也可换成 qwen-flash（最快）/ qwen3.8-flash（质量高但慢）
#DASHSCOPE_MODEL=deepseek-v4.1-flash
# 单次对话读取超时（秒），超时自动回退规则引擎，默认 30
#DASHSCOPE_TIMEOUT=30

# 高德开放平台 Web 服务 Key（选填，用于道旅不可用时的 POI 回退搜索）
# 申请地址：https://lbs.amap.com/
AMAP_API_KEY=

# 百度地图【服务端】AK（选填，评分富化的次选源：携程 → 百度 → 高德）
# 申请：https://lbsyun.baidu.com/ → 控制台 → 应用管理 → 创建应用
# 线上部署需同时在仓库 Secrets 里配置 BAIDU_MAP_AK，否则该源不生效
#BAIDU_MAP_AK=

# 评分富化的 QPS 节流（选填，默认百度 2 / 高德 5 / 携程 2）
#BAIDU_QPS_LIMIT=2
#AMAP_QPS_LIMIT=5
#CTRIP_QPS_LIMIT=2

# 道旅 RollingGo 开发者 Key（必填，真实酒店搜索/房价；mcp_ 开头）
ROLLINGGO_API_KEY=

# ===== 以下均为可选项，一般无需修改 =====
# 道旅 MCP / REST 网关地址
#ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
# OAuth 中转与授权地址（python rollinggo_book.py login 使用）
#ROLLINGGO_OAUTH_SERVER=https://api.rollinggo.store
#ROLLINGGO_OAUTH_AUTHORIZE=https://api.rollinggo.cn/oauth2/authorize
# 道旅 OAuth Client ID（国内版固定）
#ROLLINGGO_CLIENT_ID=rollinggoskill
# 直接注入 access token（可选，优先于 token 文件；一般用 login 生成）
#ROLLINGGO_ACCESS_TOKEN=
# token 存储路径（默认 ~/.hotel-cli/token.json）
#ROLLINGGO_TOKEN_FILE=~/.hotel-cli/token.json

# ===== 可选：MCP Server（把只读能力暴露给 Claude Desktop / Cursor 等外部客户端）=====
# 留空 → 不鉴权（仅建议本地/内网）。公网部署务必配一个随机串。
# 客户端请求头：Authorization: Bearer <值>
# 线上由 .gitea/workflows/deploy.yml 从 Secrets 注入，未配置则为空（等价不鉴权）
#MCP_AUTH_TOKEN=

# ===== 可选：订单持久化数据库 =====
# 留空 → 内存 dict（CLI 重启丢失，与原版行为一致）
# SQLite 零依赖（推荐，Web 版立刻能跑）：
#DATABASE_URL=sqlite:///orders.db
# MySQL（可选，需 pymysql 包 + 已装 MySQL 服务）：
#DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname
